---
import Layout from '../../../../_components/sub-page-layout.astro';
import { localeFromPath } from '../../../../i18n';
import '../../../../globals.css';
import '../../../../sub-pages.css';
import '../../../../_partials/launch-week.css';
import { LW_BODY, LW_META, LW_STATUS } from '../../../../_partials/launch-week-i18n';

const locale = localeFromPath(Astro.url.pathname);
const meta = LW_META[locale] ?? LW_META.en;
const launchWeekMain = LW_BODY[locale] ?? LW_BODY.en;

/**
 * Drop schedule. Each day flips at 08:00 UTC+8, which is exactly 00:00 UTC —
 * and UTC+8 has no daylight saving, so a plain UTC timestamp is the whole story.
 * Rendered per build; the inline script below re-resolves it in the visitor's
 * browser so a cached page still shows the right state.
 */
const DROPS = [
  { day: 1, date: 'AUG 10', iso: '2026-08-10' },
  { day: 2, date: 'AUG 11', iso: '2026-08-11' },
  { day: 3, date: 'AUG 12', iso: '2026-08-12' },
  { day: 4, date: 'AUG 13', iso: '2026-08-13' },
  { day: 5, date: 'AUG 14', iso: '2026-08-14' },
];

// The client script rewrites drop states, so it needs this locale's words too.
const statusCopy = Object.fromEntries(
  Object.entries(LW_STATUS).map(([state, byLocale]) => [state, byLocale[locale] ?? byLocale.en]),
);

const title = meta.title;
const description = meta.description;
const fallbackSite = 'https://open-design.ai/';
const ogImage = new URL('/launch-week/launch-week-og.jpg', Astro.site ?? fallbackSite).toString();


/**
 * Shared key that unlocks `?preview=`. Not a secret in the cryptographic sense —
 * the page is static, so anything here ships to the client. It only has to stop
 * a casual visitor from reading the running order off a URL guess. Rotate it by
 * editing this constant; there is nothing else to update.
 */
const PREVIEW_KEY = 'lw01-dry-run';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  description,
  startDate: '2026-08-10T08:00:00+08:00',
  endDate: '2026-08-14T23:59:00+08:00',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'VirtualLocation',
    url: new URL(Astro.url.pathname, Astro.site ?? fallbackSite).toString(),
  },
  organizer: { '@type': 'Organization', name: 'Open Design', url: fallbackSite },
  image: [ogImage],
  performer: { '@type': 'Organization', name: 'Open Design' },
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: new URL(Astro.url.pathname, Astro.site ?? fallbackSite).toString(),
    validFrom: '2026-08-10T08:00:00+08:00',
  },
};
---

<Layout
  title={title}
  description={description}
  active="community"
  ogImage={ogImage}
  jsonLd={jsonLd}
  mainClassName="lw"
>
  <Fragment set:html={launchWeekMain} />
</Layout>

<script is:inline define:vars={{ DROPS, PREVIEW_KEY, statusCopy, PAGE_LOCALE: locale }}>
  // Resolve drop state on the client too: the page is statically built, so a
  // visitor on a cached copy must still see the correct day without a redeploy.
  (() => {
    const now = Date.now();
    const stateFor = (iso) => {
      const opens = Date.parse(iso + 'T00:00:00Z'); // 08:00 UTC+8
      const closes = opens + 86400000;
      if (now < opens) return 'classified';
      return now < closes ? 'live' : 'released';
    };

    // Preview lets the team review and screenshot any day before it happens.
    // Gated by a shared key so a visitor can't peek at the running order early:
    //   ?preview=<day>&key=<PREVIEW_KEY>   day = 1–5 | all
    // Without the key the param is ignored and the real schedule applies.
    const params = new URLSearchParams(location.search);
    const preview = params.get('key') === PREVIEW_KEY ? params.get('preview') : null;
    const simulate = (day) => {
      if (preview === 'all') return 'released';
      const n = Number(preview);
      if (!Number.isInteger(n) || n < 1 || n > 5) return null;
      return day < n ? 'released' : day === n ? 'live' : 'classified';
    };

    const states = {};
    DROPS.forEach((d) => (states[d.day] = simulate(d.day) ?? stateFor(d.iso)));
    // Before the week opens, day 1 is the one we tease as next up.
    document.documentElement.dataset.launchWeek = Object.values(states).includes('live')
      ? 'running'
      : now < Date.parse(DROPS[0].iso + 'T00:00:00Z')
        ? 'before'
        : 'after';

    const applyStates = () => {
      document.querySelectorAll('.drop[data-launch-day]').forEach((card) => {
      const state = states[card.dataset.launchDay];
      const sealed = card.classList.contains('is-classified');
      // A sealed card only belongs on screen while its day is still secret;
      // the revealed twin takes over the moment it opens.
      card.hidden = sealed ? state !== 'classified' : state === 'classified';
      if (!sealed) card.dataset.state = state;
    });

    document.querySelectorAll('.killticker li[data-launch-day]').forEach((li) => {
      const state = states[li.dataset.launchDay];
      li.classList.toggle('is-today', state === 'live');
      const slot = li.querySelector('[data-state-label]');
      if (!slot) return;
      slot.textContent =
        state === 'live' ? statusCopy.LIVE : state === 'released' ? statusCopy.RELEASED : statusCopy.CLASSIFIED;
      slot.className = state === 'live' ? 'is-live' : state === 'released' ? 'is-done' : 'is-classified';
    });
    };
    applyStates();

    // The revealed drops are not in this HTML — an unopened day must not be
    // readable from the page source days early. Ask the endpoint, which
    // releases each one on its date without needing a deploy.
    const query = new URLSearchParams({ locale: PAGE_LOCALE });
    if (preview) {
      query.set('preview', preview);
      query.set('key', PREVIEW_KEY);
    }
    fetch('/launch-week/drops?' + query)
      .then((r) => (r.ok ? r.json() : { drops: [] }))
      .then(({ drops }) => {
        const stack = document.querySelector('.lw .drop-stack');
        if (!stack) return;
        drops.forEach(({ day, html }) => {
          const sealed = stack.querySelector('.drop.is-classified[data-launch-day="' + day + '"]');
          if (!sealed) return;
          sealed.insertAdjacentHTML('beforebegin', html);
          sealed.remove();
        });
        applyStates();
        document.dispatchEvent(new CustomEvent('lw:drops-ready'));
      })
      .catch(() => {
        // Sealed cards stay put: a failed request shows the pre-launch page,
        // which is the safe direction to fail in.
      });
  })();

  // Scroll reveal. Lives here rather than in the partial so the markup stays
  // pure content; no-ops entirely when the visitor asks for reduced motion.
  (() => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const obs =
      reduce || !('IntersectionObserver' in window)
        ? null
        : new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (!e.isIntersecting) return;
                e.target.classList.add('is-in');
                obs.unobserve(e.target);
              });
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
          );

    // Runs again when the fetched drops arrive, so cards that were not in the
    // document at load still animate in — and still show without motion.
    const observe = () => {
      document.querySelectorAll('.lw .reveal, .lw .drop.is-classified .tba').forEach((el) => {
        if (el.classList.contains('is-in')) return;
        if (obs) obs.observe(el);
        else el.classList.add('is-in');
      });
    };
    observe();
    document.addEventListener('lw:drops-ready', observe);
  })();
</script>
